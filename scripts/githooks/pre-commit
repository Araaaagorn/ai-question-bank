#!/usr/bin/env bash
# ============================================================================
# pre-commit hook：提交前运行测试，确保代码不会破坏已有功能
#
# 流程：
#   1. make clean
#   2. make build
#   3. make test（全部通过则放行，任意失败则拒绝提交）
#
# 说明：直接在当前工作区构建并测试，不使用 git stash --keep-index——该方式会在
#       pop 时与暂存区冲突，导致未暂存改动被留在 stash 中甚至丢失。
#
# commit message 标记由 commit-msg hook 追加。
#
# 安装方式：
#   cp scripts/githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
# ============================================================================
set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -n "$REPO_ROOT" ] || { echo -e "${RED}[pre-commit] 无法获取仓库根目录${NC}"; exit 1; }

cd "$REPO_ROOT"

echo -e "${CYAN}[pre-commit] 开始预提交测试...${NC}"

# ── 第 1 步：make clean ──
echo -e "${CYAN}[pre-commit] 1/3: make clean${NC}"
(cd "$REPO_ROOT/server" && make clean 2>&1) || { echo -e "${RED}[pre-commit] ✘ make clean 失败${NC}"; exit 1; }

# ── 第 2 步：make build ──
echo -e "${CYAN}[pre-commit] 2/3: make build${NC}"
(cd "$REPO_ROOT/server" && make build 2>&1) || { echo -e "${RED}[pre-commit] ✘ make build 失败${NC}"; exit 1; }

# ── 第 3 步：make test ──
echo -e "${CYAN}[pre-commit] 3/3: make test${NC}"
(cd "$REPO_ROOT/server" && make test 2>&1) || { echo -e "${RED}[pre-commit] ✘ make test 失败${NC}"; exit 1; }

echo -e "${GREEN}[pre-commit] ✔ 全部测试通过，批准提交${NC}"
exit 0
