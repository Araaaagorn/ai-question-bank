@startuml uc1_auth_question
' AI+题库智能教学平台 — 用况图1：用户认证与题库管理（已实现）
' 依据：server/src/routes.c（handle_register/login/logout/me、handle_questions 及 create/update/delete）
'       server/src/auth.c、server/src/db.c、docs/auth.md、docs/questions.md
left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "用户\n(抽象)" as User
actor "管理员\nadmin" as Admin
actor "教师\nteacher" as Teacher
actor "学生\nstudent" as Student

Admin -up-|> User
Teacher -up-|> User
Student -up-|> User

rectangle "AI+题库智能教学平台 — 认证与题库管理（已实现）" {
  usecase "注册账号" as UCReg
  usecase "登录" as UCLogin
  usecase "登出" as UCLogout
  usecase "查询当前用户信息" as UCMe
  usecase "创建登录会话" as UCSess
  usecase "浏览题目列表" as UCList
  usecase "查看题目详情" as UCDetail
  usecase "新增题目" as UCCreate
  usecase "修改题目" as UCUpdate
  usecase "删除题目" as UCDelete
  usecase "校验写权限\n(teacher/admin)" as UCPerm
  usecase "校验题目字段" as UCValid
}

User --> UCReg
User --> UCLogin
User --> UCLogout
User --> UCMe
User --> UCList
User --> UCDetail

Teacher --> UCCreate
Teacher --> UCUpdate
Teacher --> UCDelete
Admin --> UCCreate
Admin --> UCUpdate
Admin --> UCDelete

UCReg ..> UCSess : <<include>>\n(注册成功自动登录)
UCLogin ..> UCSess : <<include>>
UCCreate ..> UCPerm : <<include>>
UCUpdate ..> UCPerm : <<include>>
UCDelete ..> UCPerm : <<include>>
UCCreate ..> UCValid : <<include>>
UCUpdate ..> UCValid : <<include>>

note right of UCList
  GET /api/v1/questions
  任意登录角色可读；
  当前无分页与检索（P1 待办）
end note

note bottom of UCCreate
  POST/PUT/DELETE /api/v1/questions
  权限检查先于题目存在性校验；
  前端管理页面未实现，
  当前经 HTTP 接口工具调用
  （server/src/routes.c）
end note

note bottom of UCSess
  会话为服务端内存数组（128 槽，24h 过期）
  Token：OpenSSL 随机 64 位十六进制
  （server/src/auth.c）
end note
@enduml
