[Unit]
Description=AI Question Bank Server (C / libmicrohttpd)
After=network.target

[Service]
# 按实际部署用户/路径调整
User=www-data
Group=www-data
WorkingDirectory=/opt/ai-question-bank/server
EnvironmentFile=/opt/ai-question-bank/server/.env
ExecStart=/opt/ai-question-bank/server/ai-question-bank-server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
