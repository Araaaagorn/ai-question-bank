[Unit]
Description=AI Question Bank Backend (Uvicorn)
After=network.target

[Service]
# 按实际部署用户/路径调整
User=www-data
Group=www-data
WorkingDirectory=/opt/ai-question-bank/backend
EnvironmentFile=/opt/ai-question-bank/backend/.env
ExecStart=/opt/ai-question-bank/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
