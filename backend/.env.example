# 后端配置示例 —— 复制为 .env 后填写真实值（.env 不入库）
# 运行环境：development / production / test
APP_ENV=development

# 服务端口
PORT=8000

# 数据库：开发用 SQLite，生产切换 PostgreSQL
# 示例：postgresql+psycopg://user:pass@localhost:5432/ai_question_bank
DATABASE_URL=sqlite:///./data/ai_question_bank.db

# 会话/令牌签名密钥（生产必须替换为随机值，如 secrets.token_hex(32)）
SECRET_KEY=change-me-in-production

# 大模型 API（OpenAI 兼容协议，可对接多家供应商）
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# CORS 允许来源（开发期前端地址）
CORS_ORIGINS=http://localhost:5173
